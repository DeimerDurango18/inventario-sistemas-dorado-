# Configuración del backend
# DB_ENGINE: mssql (producción) o sqlite (desarrollo rápido, no requiere SQL Server)
DB_ENGINE=mssql
DB_HOST=localhost\SQLExpress
DB_PORT=1433
DB_NAME=InventarioEquipos
DB_USER=sa
DB_PASSWORD=TuPasswordAqui
DB_DRIVER=ODBC Driver 18 for SQL Server

# Seguridad
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / frontend
# FRONTEND_URL: origen que consume la API (frontend en dev/producción).
#   - Desarrollo:  http://localhost:5173
#   - Netlify:     https://durango-dev.netlify.app  (tu dominio de Netlify)
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS (opcional): lista de orígenes permitidos separados por coma.
# Si NO se define, usa FRONTEND_URL.
# CORS_ORIGINS=https://durango-dev.netlify.app,http://localhost:5173

# Datos de la empresa usados en el PDF de las actas (SALIDA / ENTRADA)
COMPANY_NAME=SISTEMAS BOGOTA
COMPANY_NIT=900123456-1
COMPANY_PHONE=3157736033
COMPANY_ADDRESS=CALLE 26 N 68C-61 BOGOTA
COMPANY_WATERMARK=SISTEMAS BOGOTA
