# Configuración del backend
# DB_ENGINE: mssql (producción) o sqlite (desarrollo rápido, no requiere SQL Server).
DB_ENGINE=mssql
DB_HOST=localhost\SQLExpress
DB_PORT=1433
DB_NAME=InventarioEquipos
# Usuario dedicado de la aplicación (NO usar 'sa' en producción).
DB_USER=inventario_app
DB_PASSWORD=TuPasswordSeguroAqui
DB_DRIVER=ODBC Driver 18 for SQL Server

# Seguridad
# SECRET_KEY: clave larga y aleatoria para firmar tokens JWT.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# En producción (DEBUG=False) el backend ABORTA si esta clave es débil o falta.
SECRET_KEY=change-me-con-una-clave-aleatoria-de-al-menos-32-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / frontend
# FRONTEND_URL: origen principal que consume la API (frontend en dev/producción).
#   - Desarrollo:  http://localhost:5173
#   - Netlify:     https://durango-dev.netlify.app
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS (opcional): lista de orígenes permitidos separados por coma.
# Si NO se define, usa FRONTEND_URL.
CORS_ORIGINS=https://inventario-equipos.pages.dev,http://localhost:5173,https://durango-dev.netlify.app

# Notificaciones por correo (opcional). Dejar SMTP_HOST vacío lo deshabilita.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=correo@empresa.com
# SMTP_PASSWORD=password
# SMTP_FROM=correo@empresa.com
# SMTP_TLS=true

# Datos de la empresa usados en el PDF de las actas (SALIDA / ENTRADA)
COMPANY_NAME=SISTEMAS BOGOTA
COMPANY_NIT=892300678-1
COMPANY_PHONE=3157736033
COMPANY_ADDRESS=Carrera 98 # 25g - 10
COMPANY_WATERMARK=SISTEMAS BOGOTA