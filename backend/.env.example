# ============================================================
# ETICOS - Gestión de Activos TI
# Copia este archivo como backend/.env y completa los valores.
# NUNCA subas backend/.env al repositorio.
# ============================================================

# --- Base de datos ---
DB_ENGINE=mssql
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLExpress
DB_DATABASE=InventarioEquipos
DB_USERNAME=inventario_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_ENCRYPT=1

# --- Seguridad ---
# Genera una clave aleatoria de 32+ caracteres.
SECRET_KEY=CAMBIA_POR_UNA_CLAVE_ALEATORIA_LARGA
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_ADMIN_EMAIL=admin@eticos.local
SEED_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN

# --- Aplicación ---
DEBUG=False
AUTO_CREATE_SCHEMA=False
ENABLE_DOCS=True
API_PORT=8500
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Datos de empresa ---
COMPANY_NAME=ETICOS S.A.S.
COMPANY_NIT=
COMPANY_PHONE=
COMPANY_ADDRESS=

# --- Almacenamiento ---
STORAGE_PATH=./storage
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.xlsx,.csv,.doc,.docx
