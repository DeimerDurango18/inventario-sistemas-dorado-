# Configuracion del backend. Copia este archivo como `backend/.env` y ajusta
# los valores. Las variables de entorno del sistema tienen prioridad.

# ===== Base de datos (SQL Server) =====
# DB_ENGINE=mssql
# DB_SERVER=localhost\SQLExpress
# DB_DATABASE=InventarioEquipos
# DB_USERNAME=inventario_app
# DB_PASSWORD=cambiar
# DB_PORT=1433

# ===== Seguridad JWT =====
# SECRET_KEY=cambiar
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== SMTP (opcional, para el resumen por correo) =====
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# SMTP_TLS=1

# ===== WhatsApp (aviso por WhatsApp) =====
WHATSAPP_GATEWAY_URL=http://127.0.0.1:8900
WHATSAPP_DESTINOS=3157410696,3153199403