# ============================================================
# ETICOS - Gestión de Activos TI  (backend)
# Copia este archivo como backend/.env y completa los valores.
# NUNCA subir .env al repositorio.
# ============================================================

# --- Base de datos ---
DB_ENGINE=mssql
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLExpress
DB_DATABASE=InventarioEquipos
DB_USERNAME=inventario_app
DB_PASSWORD=__CAMBIA_ESTA_CLAVE__
DB_ENCRYPT=0

# --- Seguridad / JWT ---
SECRET_KEY=__GENERA_UNA_CLAVE_ALEATORIA_LARGA__
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Aplicación ---
DEBUG=True
API_PORT=8500
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Datos de la empresa (PDFs / actas) ---
COMPANY_NAME=ETICOS S.A.S.
COMPANY_NIT=892300678-1
COMPANY_PHONE=
COMPANY_ADDRESS=

# --- Almacenamiento local ---
STORAGE_PATH=./storage