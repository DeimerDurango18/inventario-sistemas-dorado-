# Copia este archivo como backend/.env y completa los valores para tu entorno.
# Nunca subas backend/.env al repositorio.
DB_ENGINE=mssql
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLExpress
DB_DATABASE=InventarioEquipos
DB_USERNAME=inventario_app
DB_PASSWORD=cambia_esta_contrasena

# Genera una clave larga y aleatoria para producción.
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_larga
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=False
CORS_ORIGINS=http://localhost:4123
