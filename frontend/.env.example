# Variables de entorno del frontend (React/Vite)
#
# En desarrollo local copia este archivo como `.env` (o usa la terminal).
# En Netlify define estas variables en: Site configuration > Build & deploy > Environment variables.
#   - También puedes crear el archivo desde Netlify > Settings > Environment variables.

# URL pública de tu API FastAPI.
#   Dev local:    http://localhost:8010
#   Netlify prod: https://tu-api.com   (debe ser accesible desde internet)
# Tu sitio Netlify: https://durango-dev.netlify.app
# Si no se define, el frontend usa http://localhost:8010 por defecto.
VITE_API_URL=http://localhost:8010