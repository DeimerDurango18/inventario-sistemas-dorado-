# ETICOS - Cache-Control
# El index.html nunca se cachea: siempre carga el bundle actual (que apunta
# a la URL viva del tunel cloudflared). Los assets con hash son inmutables.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
**/*.js
  Cache-Control: public, max-age=31536000, immutable
**/*.css
  Cache-Control: public, max-age=31536000, immutable